    // ===================== 初始化入口 =====================
    window.addEventListener('load', () => {
        setTimeout(() => {
            initExtremeController();
            startPopupObserver();
            // 启动顺序：说明弹窗 →关闭→创建控制面板
            createGuidePopup(async ()=>{
                createUI();
                // 页面加载完成后自动执行更新检测
                await autoCheckUpdateTask();
            });
        }, 2000);
    });

    let activeUrl = location.href;
    setInterval(() => {
        if (location.href !== activeUrl) {
            activeUrl = location.href;
            setTimeout(()=>{
                initExtremeController();
                // 页面内切换课程，不再连续弹出双弹窗，只运行挂机功能
            }, 2000);
        }
    }, 1500);

})();
