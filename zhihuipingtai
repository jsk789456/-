    // ===================== 版本对比工具函数 =====================
    function versionCompare(v1, v2) {
        const arr1 = v1.split('.').map(Number);
        const arr2 = v2.split('.').map(Number);
        for (let i = 0; i < Math.max(arr1.length, arr2.length); i++) {
            const a = arr1[i] || 0;
            const b = arr2[i] || 0;
            if (a > b) return 1;
            if (a < b) return -1;
        }
        return 0;
    }

    // =====================【在线更新检测函数】=====================
    async function checkUpdate(showNoUpdateMsg = false) {
        return new Promise((resolve) => {
            GM_xmlhttpRequest({
                method: "GET",
                url: CONFIG.remoteScriptUrl,
                timeout: 8000,
                onload: (res) => {
                    const text = res.responseText;
                    // 正则提取远程版本号
                    const verMatch = text.match(/@version\s+([\d.]+)/);
                    if (!verMatch) {
                        resolve({success:false,msg:"无法获取远程版本信息"});
                        return;
                    }
                    const remoteVer = verMatch[1];
                    const cmp = versionCompare(remoteVer, CONFIG.currentVersion);
                    if(cmp > 0){
                        resolve({
                            success:true,
                            hasNew:true,
                            localVer:CONFIG.currentVersion,
                            remoteVer:remoteVer,
                            url:CONFIG.remoteScriptUrl
                        });
                    }else{
                        resolve({
                            success:true,
                            hasNew:false,
                            localVer:CONFIG.currentVersion,
                            remoteVer:remoteVer
                        });
                    }
                },
                onerror: ()=> resolve({success:false,msg:"网络请求失败，无法连接GitHub"}),
                ontimeout: ()=> resolve({success:false,msg:"请求超时"})
            })
        })
    }

